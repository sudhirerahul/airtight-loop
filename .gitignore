# Runtime live-capture data — regenerated by the pollers, not committed
feed/captured/*.ndjson

# fix_loop run records — regenerated on every run; one demo sample is
# force-added (git add -f) to keep provenance of a real end-to-end run
agent/runs/*.json

# diff_gate run records — same convention as agent/runs/*.json above
replay/runs/*.json

# Secrets — never commit an API key
.env
*.env

# Java / Maven
engine/target/
replay/target/
target/

# Python
__pycache__/
*.pyc

# OS
.DS_Store
